;; mihari parity fixture — guest（aiueos/mihari_core.cljk）と adapter（src/mihari/core.cljk）
;; が同じ数を返すことの表。
;;
;; - adapter 側: test/mihari/parity_test.cljk がこの表を全件読んで照合する。
;; - guest 側: 同じ行を aiueos/mihari_core.cljk の test-* に手で書いてある
;;   （guest は EDN を読めない）。行を足したら test-* も足す。対応は guest の docstring。
;; - wasm 側: test/guest_parity.mjs が wasm を読んで同じ表を回す（docs/aiueos-dapp.md）。
;;
;; 符号: level debug=0 info=1 warning=2 error=3 fatal=4
;;       status unresolved=0 resolved=1 ignored=2
;;       action unresolve=0 resolve=1 ignore=2 event=3
;;       priority low=0 medium=1 high=2（不正入力は -1）
[;; fingerprint — UTF-16 code unit の多項式ハッシュ（h = (h*31 + c) mod 2147483647、初期値 7）
 {:fn "fingerprint" :args [[]] :expect 7 :note ""}
 {:fn "fingerprint" :args [[97]] :expect 314 :note "a"}
 {:fn "fingerprint" :args [[97 98]] :expect 9832 :note "ab"}
 {:fn "fingerprint" :args [[84 121 112 101 69 114 114 111 114]] :expect 1123801053 :note "TypeError"}
 {:fn "fingerprint" :args [[84 121 112 101 69 114 114 111 114 58 32 120 32 105 115 32 117 110 100 101 102 105 110 101 100]] :expect 2137996913 :note "TypeError: x is undefined"}
 {:fn "fingerprint" :args [[35211 24373 12426]] :expect 34814297 :note "見張り"}
 {:fn "fingerprint" :args [[55357 56832]] :expect 1779626 :note "サロゲートペア 1 文字"}
 ;; next-status
 {:fn "next-status" :args [0 1] :expect 1}
 {:fn "next-status" :args [0 2] :expect 2}
 {:fn "next-status" :args [1 0] :expect 0}
 {:fn "next-status" :args [1 3] :expect 0 :note "resolved に event = regression"}
 {:fn "next-status" :args [0 3] :expect 0}
 {:fn "next-status" :args [2 3] :expect 2 :note "ignored は event で起きない"}
 {:fn "next-status" :args [2 0] :expect 0}
 {:fn "next-status" :args [3 1] :expect -1}
 {:fn "next-status" :args [0 4] :expect -1}
 {:fn "next-status" :args [-1 0] :expect -1}
 ;; regression?
 {:fn "regression?" :args [1 3] :expect 1}
 {:fn "regression?" :args [0 3] :expect 0}
 {:fn "regression?" :args [2 3] :expect 0}
 {:fn "regression?" :args [1 1] :expect 0}
 ;; priority — mihari の規則（Sentry 本家の算出ではない）
 {:fn "priority" :args [4 1 0] :expect 2}
 {:fn "priority" :args [3 1 0] :expect 1}
 {:fn "priority" :args [3 1 10] :expect 2}
 {:fn "priority" :args [3 100 0] :expect 2}
 {:fn "priority" :args [3 99 9] :expect 1}
 {:fn "priority" :args [2 1 10] :expect 1}
 {:fn "priority" :args [2 1 9] :expect 0}
 {:fn "priority" :args [1 500 500] :expect 0}
 {:fn "priority" :args [0 1 1] :expect 0}
 {:fn "priority" :args [5 1 1] :expect -1}
 {:fn "priority" :args [3 -1 0] :expect -1}
 ;; level-at-least?
 {:fn "level-at-least?" :args [3 2] :expect 1}
 {:fn "level-at-least?" :args [2 3] :expect 0}
 {:fn "level-at-least?" :args [4 4] :expect 1}
 {:fn "level-at-least?" :args [5 0] :expect 0}
 ;; sampled? — hash を 1,000,000 で割った非負の余りが rate-ppm 未満なら 1
 {:fn "sampled?" :args [123456789 1000000] :expect 1}
 {:fn "sampled?" :args [123456789 0] :expect 0}
 {:fn "sampled?" :args [123456789 456790] :expect 1}
 {:fn "sampled?" :args [123456789 456789] :expect 0}
 {:fn "sampled?" :args [-1 1000000] :expect 1}
 {:fn "sampled?" :args [-1 999999] :expect 0}
 {:fn "sampled?" :args [5 2000000] :expect 1 :note "rate は 1,000,000 に丸める"}
 {:fn "sampled?" :args [5 -3] :expect 0 :note "rate は 0 に丸める"}
 ;; max-level
 {:fn "max-level" :args [2 3] :expect 3}
 {:fn "max-level" :args [4 0] :expect 4}
 {:fn "max-level" :args [7 1] :expect -1}]
