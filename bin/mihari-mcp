#!/usr/bin/env kbb
;; mihari の stdio MCP サーバ（Linear JUN-297）。
;;
;; itonami agent（kotoba-lang/itonami-agent）は呼び出しのたびにこのプロセスを
;; 1 つ起動し、initialize → notifications/initialized → 要求 の 3 行を stdin に
;; 書いて閉じ、stdout から id の合う応答を拾う。だからこのファイルの約束は:
;;
;;   - stdout には JSON-RPC の行だけを書く（ログは stderr）
;;   - 1 行読んだら、応答があれば 1 行書く（通知には書かない）
;;   - stdin の EOF で exit 0（process.exit で打ち切らない —— macOS の pipe への
;;     書き込みは非同期なので、未送の応答を捨てることになる）
;;
;; tool の中身は src/mihari/mcp.cljk（純関数）。ネットワーク・ファイル書き込み・
;; 状態保存はしない。
;;
;; ## 依存は repo の nbb.edn の pin から取る
;;
;; kbb の既定 classpath は west の兄弟 checkout（`kotoba-lang/text/src`）を含み、
;; `add-classpath` は末尾に足すだけなので、手元の checkout が作業中のブランチに
;; あればそちらが勝つ（実測 2026-10-22: cwd `/` の `kbb -Spath` の 2 番目が
;; `~/github/kotoba-lang/text/src`）。kbb は cwd の nbb.edn の :deps
;; （kotoba-lang/text の固定 sha）を先に置くので、cwd がこの repo でなければ、
;; repo を cwd にして自分を起動し直す。stdin / stdout はそのまま子に渡す。
;; dandori の bin/dandori-mcp と同じ方式。
(ns mihari-mcp
  (:require ["node:child_process" :as cp]
            ["node:fs" :as fs]
            ["node:path" :as path]
            ["node:readline" :as readline]
            [nbb.core :refer [*file*]]))

(def repo-directory
  (fs/realpathSync (path/resolve (path/dirname *file*) "..")))

(def ^:private reexec-env "MIHARI_MCP_REEXEC")

(defn- cwd-is-repo? []
  (= (fs/realpathSync (js/process.cwd)) repo-directory))

(when-not (cwd-is-repo?)
  (if (aget js/process.env reexec-env)
    (do (.write js/process.stderr "mihari-mcp: cwd is not the repository after re-exec\n")
        (js/process.exit 70))
    (let [r (cp/spawnSync "kbb" #js [(path/join repo-directory "bin" "mihari-mcp")]
                          #js {:cwd repo-directory
                               :stdio "inherit"
                               :env (js/Object.assign #js {} js/process.env
                                                      (clj->js {reexec-env "1"}))})]
      (when-let [e (.-error r)]
        (.write js/process.stderr (str "mihari-mcp: could not start kbb: " (.-message e) "\n")))
      (js/process.exit (if (number? (.-status r)) (.-status r) 1)))))

(require '[mihari.mcp :as mcp])

(defn- write-line! [s]
  (.write js/process.stdout (str s "\n")))

(defn- handle! [line]
  (try
    (some-> (mcp/handle-line line) write-line!)
    (catch :default e
      (.write js/process.stderr (str "mihari-mcp: " (.-message e) "\n"))
      (write-line! (mcp/->json {"jsonrpc" "2.0" "id" nil
                                "error" {"code" -32603 "message" "internal error"}})))))

(let [rl (.createInterface readline #js {:input js/process.stdin :terminal false})]
  (.on rl "line" handle!)
  (.on rl "close" (fn [] (set! (.-exitCode js/process) 0))))
